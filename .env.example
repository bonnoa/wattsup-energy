# Copier en .env.local (dev) ou renseigner dans Coolify (prod).
# Les variables sont introduites au fil des tâches (voir docs/TASKS.md).

# T2 : base de données et authentification
DATABASE_URL=postgres://wattsup:wattsup@localhost:5432/wattsup
# Générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-dev-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# T11 : production (Docker / Coolify)
# RUN_MIGRATIONS=on   # migrations appliquées au démarrage ; off pour les gérer à la main

# T16 : calendrier Tempo (off = aucun appel sortant)
# TEMPO_SYNC=on

# T16b : météo Open-Meteo (off = aucun appel sortant)
# WEATHER_SYNC=on

# Inscription : open (par défaut), invite (code exigé) ou closed. Une valeur inconnue ferme
# les inscriptions. Valeur de départ seulement : le réglage de l'administrateur (page
# Utilisateurs) la remplace dès qu'il est enregistré.
# SIGNUP_MODE=open
# Codes d'invitation acceptés en mode invite, séparés par des virgules.
# INVITE_CODES=

# Mot de passe oublié : envoi d'emails par Resend. Les deux sont nécessaires ; sans elles,
# le lien « Mot de passe oublié ? » n'apparaît pas. Domaine de MAIL_FROM vérifié dans Resend.
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=WattsUp Energy <noreply@exemple.fr>

# Compte de démo local (dev uniquement ; réutilisé par le seed en T15)
DEMO_EMAIL=demo@wattsup.local
DEMO_PASSWORD=wattsup-demo-local

# Notifications push (facultatif, T49) : clés VAPID de l'instance, générées une fois avec
#   npx web-push generate-vapid-keys
# Sans elles, l'option « Notifications » n'apparaît pas dans Mon compte. VAPID_SUBJECT :
# contact transmis aux services push (mailto:… ; à défaut, BETTER_AUTH_URL).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@exemple.fr
