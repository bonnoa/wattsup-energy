# Copier en .env.local (dev) ou renseigner dans Coolify (prod).
# Les variables sont introduites au fil des tâches (voir docs/TASKS.md).

# T2 : base de données et authentification
DATABASE_URL=postgres://wattsup:wattsup@localhost:5432/wattsup
# Générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-dev-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# T11 : production (Docker / Coolify)
# RUN_MIGRATIONS=on   # migrations appliquées au démarrage ; off pour les gérer à la main

# T16 : calendrier Tempo (off = aucun appel sortant)
# TEMPO_SYNC=on

# T16b : météo Open-Meteo (off = aucun appel sortant)
# WEATHER_SYNC=on

# Inscription : open (par défaut), invite (code exigé) ou closed. Une valeur inconnue ferme
# les inscriptions.
# SIGNUP_MODE=open
# Codes d'invitation acceptés en mode invite, séparés par des virgules.
# INVITE_CODES=

# Compte de démo local (dev uniquement ; réutilisé par le seed en T15)
DEMO_EMAIL=demo@wattsup.local
DEMO_PASSWORD=wattsup-demo-local
